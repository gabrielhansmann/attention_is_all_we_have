# Copy to .env (gitignored) and fill in. Never commit real values.
# See skills/database-setup/SKILL.md for where each value comes from.

# OpenAI: embeddings (text-embedding-3-small) and answers
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Supabase Postgres connection string (direct, or session pooler on port 5432)
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Orchestrator planner: llm (default, uses OpenAI) or rules (keyword planner for local work without a key)
# PLANNER=llm

# Optional: origins allowed to call the API (comma separated)
# CORS_ORIGINS=http://localhost:5173
